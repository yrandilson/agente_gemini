# ==============================================
# AGENTE GEMINI — Configurações
# ==============================================

# Chave da Google AI Studio (obrigatório)
# Obtenha grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Modelo — use um dos disponíveis:
# gemini-2.5-flash  (rápido, grátis no free tier)
# gemini-2.5-pro    (mais capaz)
# gemini-2.0-flash  (alternativa estável)
GEMINI_MODEL=gemini-2.5-flash

# Porta do servidor web
PORT=5000

# Mostrar logs detalhados
VERBOSE=true
